# --- Required ---------------------------------------------------------------
DISCORD_TOKEN=your-discord-bot-token
# Shared secret between the dashboard and the API (npm run setup generates one)
API_TOKEN=change-me
# Server the dashboard controls
GUILD_ID=your-guild-id

# --- Optional ---------------------------------------------------------------
API_PORT=3000
# Dev only: the Vite dashboard origin
CORS_ORIGIN=http://localhost:5173
# Defaults: backend/piper/piper(.exe), backend/voices, ffmpeg bundled by ffmpeg-static
# PIPER_BIN=
# VOICES_DIR=
# FFMPEG_BIN=
# MAX_QUEUE_LENGTH=20
# MAX_TEXT_LENGTH=500

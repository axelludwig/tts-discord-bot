# --- Required ---------------------------------------------------------------
DISCORD_TOKEN=your-discord-bot-token
# Shared secret between the dashboard and the API (npm run setup generates one)
API_TOKEN=change-me
# Server the dashboard controls; slash commands are registered there instantly.
# Leave empty to register them globally (can take up to 1h to appear).
GUILD_ID=your-guild-id

# --- Optional ---------------------------------------------------------------
API_PORT=3000
# Dev only: the Vite dashboard origin
CORS_ORIGIN=http://localhost:5173
# Defaults: backend/piper/piper(.exe), backend/voices, ffmpeg bundled by ffmpeg-static
# PIPER_BIN=
# VOICES_DIR=
# FFMPEG_BIN=
# MAX_QUEUE_LENGTH=20
# MAX_TEXT_LENGTH=500
# Voice used when the user has not picked one with /voix
# DEFAULT_VOICE=fr_FR-siwis-medium
# Read a text channel aloud (/tts-salon). Requires the privileged "Message Content"
# intent ticked in the Developer Portal, otherwise the bot cannot log in.
# ENABLE_TEXT_CHANNEL=false
# SETTINGS_FILE=data/settings.json
